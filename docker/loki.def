# loki image for Apptainer (same recipe as docker/Dockerfile.floor).
#
#   apptainer build loki.sif docker/loki.def           # from the repo root
#   apptainer exec --nv loki.sif loki --version
#   HTCondor: +SingularityImage = "loki.sif"
#
# Floor toolchain: Ubuntu 22.04 (GCC 11, HDF5 1.10), CUDA 12.4 (driver >= R525).
# CPU code is x86-64-v2 (SSE4.2, POPCNT, SSSE3). A baseline guest such as
# qemu64 will SIGILL. SASS for sm_75..sm_90. For AVX2 or AVX-512 nodes:
# apptainer build --build-arg LOKI_CPU_ARCH=x86-64-v3 ...
Bootstrap: docker
From: nvidia/cuda:12.4.1-devel-ubuntu22.04
Stage: build

%arguments
    LOKI_CPU_ARCH=x86-64-v2
    LOKI_CUDA_ARCHITECTURES=75;80;86;89;90
    JOBS=8

%files
    . /src/loki

%post
    set -eu
    apt-get update && apt-get install -y --no-install-recommends \
        g++ git ca-certificates curl libhdf5-dev
    rm -rf /var/lib/apt/lists/*
    curl -LsSf https://astral.sh/uv/0.8.17/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy UV_NO_CACHE=1
    export CMAKE_BUILD_PARALLEL_LEVEL={{ JOBS }}
    uv venv --python 3.12 /opt/loki
    uv pip install --python /opt/loki cmake ninja
    PATH=/opt/loki/bin:$PATH uv pip install --python /opt/loki /src/loki \
        -Ccmake.define.LOKI_CUDA=ON \
        -Ccmake.define.LOKI_ENABLE_NATIVE_ARCH=OFF \
        "-Ccmake.define.LOKI_CPU_ARCH={{ LOKI_CPU_ARCH }}" \
        "-Ccmake.define.LOKI_CUDA_ARCHITECTURES={{ LOKI_CUDA_ARCHITECTURES }}" \
        -Cbuild-dir=/tmp/loki-build
    rm -rf /tmp/loki-build

Bootstrap: docker
From: nvidia/cuda:12.4.1-base-ubuntu22.04
Stage: final

%files from build
    # One line per directory: the base image already has /opt (/opt/nvidia),
    # and "/opt /opt" would copy into it as /opt/opt.
    /opt/python /opt/python
    /opt/loki /opt/loki

%post
    apt-get update && apt-get install -y --no-install-recommends libgomp1 libhdf5-103-1
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/loki/bin:$PATH

%runscript
    exec loki "$@"
