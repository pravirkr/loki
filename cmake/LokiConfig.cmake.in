
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Hard system dependencies required by every loki build.
find_dependency(OpenMP)
find_dependency(HDF5)

# Static loki archives reference FFTW symbols; shared builds bundle FFTW privately.
if(NOT @LOKI_BUILT_AS_SHARED@)
  find_dependency(FFTW COMPONENTS FLOAT_LIB)
endif()

# CUDA is only required when this loki build was configured with CUDA support.
include("${CMAKE_CURRENT_LIST_DIR}/lokiCUDAConfig.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/lokiTargets.cmake")

check_required_components(loki)
