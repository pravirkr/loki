---
# clang-tidy configuration (see docs/architecture.md, Tooling).
#
# Run: run-clang-tidy -p build-dev "$PWD/(lib|src|tests|applications)/"
# tests/.clang-tidy inherits this file and relaxes a few test-only checks.
#
# Notable disabled checks and why:
#   clang-analyzer-deadcode.DeadStores  the analyzer does not see uses in
#                                       OpenMP clauses (num_threads(n))
#   openmp-exception-escape             exceptions in regions are accepted
#   llvm-header-guard, portability-avoid-pragma-once  we use #pragma once
#   magic numbers, pointer arithmetic, reinterpret_cast, unchecked access
#                                       HPC kernels index raw buffers
#
# NOLINT rule: always name the check and give a reason, e.g.
#   // NOLINT(google-runtime-int): matches std::strtoul
Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-incorrect-roundings,
  clang-analyzer-*,
  -clang-analyzer-deadcode.DeadStores,
  clang-diagnostic-*,
  concurrency-*,
  cppcoreguidelines*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-prefer-member-initializer,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-slicing,
  google-*,
  hicpp-*,
  llvm-*,
  -llvm-header-guard,
  -llvm-prefer-static-over-anonymous-namespace,
  -llvm-use-ranges,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  modernize-*,
  -modernize-loop-convert,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  openmp-*,
  -openmp-exception-escape,
  performance-*,
  portability-*,
  -portability-avoid-pragma-once,
  readability-*,
  -readability-identifier-length,
  -readability-isolate-declaration,
  -readability-magic-numbers,
  -readability-suspicious-call-argument,
  -readability-use-anyofallof,
  -readability-use-concise-preprocessor-directives,

HeaderFileExtensions: ["h", "hh", "hpp", "hxx", "cuh"]
WarningsAsErrors: ""
HeaderFilterRegex: "(^|/)(include/loki/|lib/|src/|tests/|bench/|applications/)"
# Third-party code (CPM cache, FetchContent _deps, system prefixes) matches
# the filter above through its own include/ and src/ folders.
ExcludeHeaderFilterRegex: "(/_deps/|/\\.cache/|^/opt/|^/usr/|miniforge|miniconda|/envs/|/site-packages/)"
FormatStyle: "file"
CheckOptions:
  readability-identifier-naming.ClassCase: "CamelCase"
  readability-identifier-naming.ClassMemberCase: "lower_case"
  readability-identifier-naming.EnumCase: "CamelCase"
  readability-identifier-naming.FunctionCase: "lower_case"
  readability-identifier-naming.MacroDefinitionCase: "UPPER_CASE"
  readability-identifier-naming.MemberCase: "lower_case"
  readability-identifier-naming.PrivateMemberPrefix: "m_"
  readability-identifier-naming.ProtectedMemberPrefix: "m_"
  readability-identifier-naming.NamespaceCase: "lower_case"
  readability-identifier-naming.ParameterCase: "lower_case"
  readability-identifier-naming.TypeAliasCase: "CamelCase"
  readability-identifier-naming.TypedefCase: "CamelCase"
  readability-identifier-naming.VariableCase: "lower_case"
  readability-identifier-naming.StaticVariableCase: "lower_case"
  readability-identifier-naming.ConstexprVariableCase: "CamelCase"
  readability-identifier-naming.ConstexprVariablePrefix: "k"
  readability-identifier-naming.EnumConstantCase: "CamelCase"
  readability-identifier-naming.EnumConstantPrefix: "k"
  readability-identifier-naming.GlobalConstantCase: "CamelCase"
  readability-identifier-naming.GlobalConstantPrefix: "k"
  readability-identifier-naming.MemberConstantCase: "CamelCase"
  readability-identifier-naming.MemberConstantPrefix: "k"
  readability-identifier-naming.StaticConstantCase: "CamelCase"
  readability-identifier-naming.StaticConstantPrefix: "k"
  readability-identifier-naming.StructCase: "CamelCase"
  readability-identifier-naming.TemplateParameterCase: "CamelCase"
  readability-function-cognitive-complexity.IgnoreMacros: "true"
  readability-function-cognitive-complexity.Threshold: "150"
  readability-trailing-comma.SingleLineCommaPolicy: Ignore
  # Umbrella and third-party headers: their symbols come through public
  # entry points, and pybind11/stl.h, numpy.h, functional.h etc. register
  # type casters, so an "unused" one must never be removed.
  misc-include-cleaner.IgnoreHeaders: "pybind11/.*;highfive/.*;catch2/.*;xsimd/.*;fmt/.*;spdlog/.*;omp\\.h;cuda.*;cufft.*;thrust/.*;cub/.*;boost/.*;toml\\+\\+/.*;CLI/.*;BS_thread_pool.*;psrio/.*;fftw3\\.h;hdf5\\.h;H5.*\\.h"
